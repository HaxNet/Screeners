{
  "manifest_version": 3,
  "key": "",
  "name": "Screeners — Screenshot & Screen Recorder",
  "version": "1.0.1",
  "description": "Capture awesome shots: visible tab, full page, or selected area screenshots with crop, plus screen recording. Save locally or to YOUR OWN Google Drive.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "downloads",
    "storage",
    "identity"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Screeners"
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "capture-visible": {
      "suggested_key": { "default": "Alt+Shift+V" },
      "description": "Screenshot visible area"
    },
    "capture-area": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "Screenshot selected area"
    },
    "start-recording": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Open screen recorder"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["editor/editor.html", "recorder/recorder.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
